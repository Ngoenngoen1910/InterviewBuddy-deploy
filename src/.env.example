# Copy this file to .env.local and fill in the values you received from Nhân.
# .env.local is git-ignored. Never commit real keys, paste them in a public
# Slack channel, or take screenshots of them.

# --- Supabase (Project Settings > API) ---
# Public: bundled into the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# Configured in Supabase > Authentication > Providers > Google.
# The app code does not read these; they are kept here for reference only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini API (server only) ---
GEMINI_API_KEY=
# Model name, e.g. the current free Flash model chosen by Hưng.
# Must support structured output (used by /api/analyze and /api/analyze-fit).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# --- Standalone analysis API (npm run api:standalone) only ---
# Not used by `npm run dev`; Next.js serves /api/analyze-fit on port 3000.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Seed script and Session API test (npm run seed, npm run test:session-api) ---
# Password for the two test users candidate.a / candidate.b@interviewbuddy.test.
# Dev/staging only; never a real password.
SEED_USER_PASSWORD=
# App to test; defaults to http://localhost:3000.
API_BASE_URL=
